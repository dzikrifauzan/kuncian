# Salin file ini jadi .env, lalu isi sesuai kebutuhan:   cp .env.example .env

# ---- Wajib ----
# Alamat publik aplikasi (pakai https). Dipakai untuk link reset password di email
# dan supaya cookie login ditandai aman.
APP_URL=https://kuncian.contoh.com

# Port di VPS yang diteruskan oleh Nginx (hanya terbuka di 127.0.0.1).
PORT=3000

# ---- Tampilan ----
APP_NAME=Kuncian
# Zona waktu untuk menghitung streak harian.
APP_TZ=Asia/Jakarta

# ---- Pendaftaran ----
# Pendaftaran otomatis tertutup kalau jumlah akun sudah segini.
MAX_USERS=2

# ---- Email (reset password dan notifikasi cadangan) ----
# Kosongkan SMTP_HOST kalau belum siap. Aplikasi tetap jalan, dan link reset
# dicetak di log:  docker compose logs kuncian
SMTP_HOST=
SMTP_PORT=587
# true untuk port 465, false untuk port 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Contoh: Kuncian <halo@contoh.com>
MAIL_FROM=

# ---- Notifikasi push (opsional) ----
# Kunci dibuat otomatis saat pertama jalan dan disimpan di database.
# Isi hanya kalau mau memakai kunci sendiri.
# VAPID_SUBJECT=mailto:kamu@contoh.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Set false kalau aplikasi dibuka langsung tanpa Nginx di depannya.
# TRUST_PROXY=true
